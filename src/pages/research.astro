---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const publications = (await getCollection('publications')).map((p) => p.data);
const talks = (await getCollection('talks')).map((t) => t.data).sort((a, b) => b.year - a.year);
// Highlight the site owner's name in author lists.
const ME = 'S. R. Dabbagh';
---

<BaseLayout title="Research" description="Publications, talks and posters.">
  <header class="page-header container">
    <span class="eyebrow" data-reveal>Research</span>
    <h1 data-reveal style="--reveal-delay:80ms">Publications & talks</h1>
  </header>

  <section class="container">
    <h2 data-reveal>Journal publications <span class="muted small">(selected)</span></h2>
    <ol class="pubs">
      {
        publications.map((p, i) => (
          <li data-reveal style={`--reveal-delay:${Math.min(i, 4) * 70}ms`}>
            <h3>{p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.title}</a> : p.title}</h3>
            <p class="authors">
              {p.authors.map((a, j) => (
                <>
                  {a === ME ? <strong>{a}</strong> : a}
                  {j < p.authors.length - 1 ? ', ' : ''}
                </>
              ))}
            </p>
            <p class="venue muted">
              <em>{p.venue}</em>
              {p.publisher && ` · ${p.publisher}`}
              {p.year && ` · ${p.year}`}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container">
    <h2 data-reveal>Conferences</h2>
    <ol class="talks">
      {
        talks.map((t, i) => (
          <li data-reveal style={`--reveal-delay:${Math.min(i, 4) * 70}ms`}>
            <div class="year">{t.year}</div>
            <div>
              <p class="type">{t.type}</p>
              <h3>“{t.title}”</h3>
              <p class="muted">{t.event} · {t.place}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .small {
    font-size: 0.55em;
    font-weight: 400;
  }
  .pubs,
  .talks {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
  }
  .pubs li,
  .talks li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .pubs li:last-child,
  .talks li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .pubs h3 {
    margin-bottom: 0.4rem;
  }
  .pubs h3 a {
    text-decoration: none;
  }
  .authors,
  .venue {
    margin: 0;
    font-size: 0.97rem;
  }
  .talks li {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 1.5rem;
  }
  .talks p {
    margin: 0;
  }
  .year {
    font-weight: 650;
    color: var(--accent);
  }
  .type {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-bottom: 0.3rem !important;
  }
  @media (max-width: 640px) {
    .talks li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
