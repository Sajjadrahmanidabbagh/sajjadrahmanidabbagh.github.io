---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const me = (await getEntry('profile', 'me'))!.data;
const education = (await getCollection('education')).map((e) => e.data);
const experience = (await getCollection('experience')).map((e) => e.data);

// TODO: CV PDF not published yet (waiting for your confirmation). To publish it, add public/cv.pdf
// and set showPdf to true.
const showPdf = false;
---

<BaseLayout title="CV" description={`Curriculum vitae of ${me.name}.`}>
  <header class="page-header container">
    <span class="eyebrow" data-reveal>CV</span>
    <h1 data-reveal style="--reveal-delay:80ms">Curriculum vitae</h1>
    <p class="lead" data-reveal style="--reveal-delay:160ms">{me.title} · {me.affiliation}</p>
    {
      showPdf && (
        <p data-reveal>
          <a class="btn btn-primary" href="/cv.pdf" download>
            Download PDF <span aria-hidden="true">↓</span>
          </a>
        </p>
      )
    }
  </header>

  <section class="container overview">
    <div class="col" data-reveal>
      <h2>Education</h2>
      <ul>{education.map((e) => <li><strong>{e.title}</strong><br /><span class="muted">{e.org}{e.period && ` · ${e.period}`}</span></li>)}</ul>
    </div>
    <div class="col" data-reveal style="--reveal-delay:100ms">
      <h2>Experience</h2>
      <ul>{experience.map((e) => <li><strong>{e.title}</strong><br /><span class="muted">{e.org}{e.period && ` · ${e.period}`}</span></li>)}</ul>
    </div>
  </section>

  <section class="section container more" data-reveal>
    <a class="btn" href="/about/">About & skills</a>
    <a class="btn" href="/research/">Publications & talks</a>
    <a class="btn" href="/experience/">Awards & certificates</a>
  </section>
</BaseLayout>

<style>
  .overview {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 96px);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.97rem;
  }
  .more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 760px) {
    .overview {
      grid-template-columns: 1fr;
    }
  }
</style>
