---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const me = (await getEntry('profile', 'me'))!.data;

const boxes = [
  { href: '/about/', title: 'About & CV', text: 'Summary, education, skills, languages and more' },
  { href: '/projects/', title: 'Projects & Papers', text: 'Research projects and publications' },
  { href: '/contact/', title: 'Contact', text: 'Email and online profiles' },
];
---

<BaseLayout>
  <div class="home container">
    <section class="intro">
      <div class="photo" data-reveal>
        <Image
          src={me.photo}
          alt={me.photoAlt}
          widths={[400, 700, 1000]}
          sizes="(max-width: 760px) 70vw, 34vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="text">
        <span class="eyebrow" data-reveal>{me.title} · {me.location}</span>
        <h1 data-reveal style="--reveal-delay:80ms">{me.name}</h1>
        <p class="tagline" data-reveal style="--reveal-delay:160ms">{me.tagline}</p>
        <p class="lead" data-reveal style="--reveal-delay:240ms">{me.intro}</p>
      </div>
    </section>

    <nav class="boxes" aria-label="Sections">
      {
        boxes.map((b, i) => (
          <a href={b.href} class="box" data-reveal style={`--reveal-delay:${300 + i * 90}ms`}>
            <span class="box-title">{b.title}</span>
            <span class="box-text">{b.text}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>
  </div>
</BaseLayout>

<style>
  /* Home fits in one screen on desktop: intro on top, three boxes below. */
  .home {
    min-height: calc(100svh - 68px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(24px, 4vh, 48px);
    padding-block: clamp(20px, 4vh, 48px);
  }
  .intro {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .photo {
    height: clamp(260px, 52vh, 560px);
    aspect-ratio: 4 / 5;
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  h1 {
    font-size: clamp(2.2rem, 5.2vw, 4.4rem);
  }
  .tagline {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 500;
    margin-bottom: 1rem;
  }
  .lead {
    margin: 0;
  }

  .boxes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(1.1rem, 2.4vh, 1.75rem) 1.5rem;
    padding-right: 3.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    text-decoration: none;
    color: var(--text);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease),
      opacity 0.9s var(--ease);
  }
  .box:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
    border-color: var(--accent);
    color: var(--text);
  }
  .box-title {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .box-text {
    font-size: 0.93rem;
    color: var(--muted);
  }
  .arrow {
    position: absolute;
    right: 1.4rem;
    top: 50%;
    translate: 0 -50%;
    font-size: 1.3rem;
    color: var(--accent);
    transition: transform 0.3s var(--ease);
  }
  .box:hover .arrow {
    transform: translateX(4px);
  }

  @media (max-width: 860px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .photo {
      height: auto;
      width: min(70vw, 340px);
    }
    .boxes {
      grid-template-columns: 1fr;
    }
  }
</style>
