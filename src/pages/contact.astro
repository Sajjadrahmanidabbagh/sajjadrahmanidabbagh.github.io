---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BackButton from '../components/BackButton.astro';

const me = (await getEntry('profile', 'me'))!.data;

// Each contact is a small box; links open in a new tab so the reader stays on this page.
const contacts = [
  ...(me.email ? [{ label: 'Email', value: me.email, url: `mailto:${me.email}` }] : []),
  ...me.links.map((l) => ({ label: l.label, value: new URL(l.url).hostname.replace(/^www\./, ''), url: l.url })),
];
---

<BaseLayout title="Contact" description={`Get in touch with ${me.name}.`}>
  <section class="page-header container">
    <BackButton />
    <span class="eyebrow" data-reveal>Contact</span>
    <h1 data-reveal style="--reveal-delay:80ms">Get in touch</h1>
    <p class="lead" data-reveal style="--reveal-delay:160ms">{me.affiliation} · {me.location}</p>

    <ul class="contact-grid">
      {
        contacts.map((c, i) => (
          <li data-reveal style={`--reveal-delay:${240 + i * 80}ms`}>
            <a class="contact-box" href={c.url} target="_blank" rel="noopener noreferrer">
              <span class="c-label">{c.label}</span>
              <span class="c-value muted">{c.value}</span>
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
  }
  .contact-box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem 3rem 1.25rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-elev);
    text-decoration: none;
    color: var(--text);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .contact-box:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--accent);
    color: var(--text);
  }
  .c-label {
    font-weight: 650;
    font-size: 1.1rem;
  }
  .c-value {
    font-size: 0.88rem;
    word-break: break-word;
  }
  .arrow {
    position: absolute;
    right: 1.2rem;
    top: 1.25rem;
    color: var(--accent);
  }
</style>
