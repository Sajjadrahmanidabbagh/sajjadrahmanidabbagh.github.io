---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsList from '../../components/NewsList.astro';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);
---

<BaseLayout title="News" description="News and updates.">
  <header class="page-header container">
    <span class="eyebrow" data-reveal>News</span>
    <h1 data-reveal style="--reveal-delay:80ms">Updates</h1>
  </header>
  <section class="container">
    <NewsList items={news} />
  </section>
</BaseLayout>
