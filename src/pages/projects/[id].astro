---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTube from '../../components/YouTube.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, period, summary, tags, cover, coverAlt, youtubeId, links } = project.data;
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary}>
  <article>
    <header class="page-header container">
      <a href="/projects/" class="back muted" data-reveal>← All projects</a>
      <p class="eyebrow" data-reveal>{period}</p>
      <h1 class="title" data-reveal style="--reveal-delay:80ms">{title}</h1>
      <p class="lead" data-reveal style="--reveal-delay:160ms">{summary}</p>
      <ul class="tags" data-reveal style="--reveal-delay:220ms">{tags.map((t) => <li>{t}</li>)}</ul>
    </header>

    {
      cover && (
        <div class="banner">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[800, 1400, 2000]}
            sizes="100vw"
            loading="eager"
            transition:name={`cover-${project.id}`}
          />
        </div>
      )
    }

    <div class="section container prose" data-reveal>
      <Content />

      {youtubeId && <YouTube id={youtubeId} title={title} />}

      {
        links.length > 0 && (
          <p class="links">
            {links.map((l) => (
              <a class="btn" href={l.url} target="_blank" rel="noopener noreferrer">
                {l.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </p>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    text-decoration: none;
    font-size: 0.93rem;
  }
  .title {
    font-size: clamp(2rem, 5vw, 3.6rem);
    max-width: 20ch;
  }
  .tags {
    margin-top: 1.5rem;
  }
  .banner {
    width: min(100% - 2 * var(--gutter), 1400px);
    margin-inline: auto;
    aspect-ratio: 21 / 9;
    border-radius: calc(var(--radius) + 8px);
    overflow: hidden;
  }
  .banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (max-width: 760px) {
    .banner {
      aspect-ratio: 4 / 3;
    }
  }
</style>
