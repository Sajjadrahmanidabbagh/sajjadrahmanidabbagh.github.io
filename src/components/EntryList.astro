---
// Generic timeline list for education / experience / awards / certificates.
interface Entry {
  title: string;
  org?: string;
  location?: string;
  period?: string;
  details?: string;
}
interface Props {
  items: Entry[];
}
const { items } = Astro.props;
---

<ol class="entries">
  {
    items.map((it, i) => (
      <li class="entry" data-reveal style={`--reveal-delay:${Math.min(i, 4) * 70}ms`}>
        <div class="period muted">{it.period}</div>
        <div class="body">
          <h3>{it.title}</h3>
          {(it.org || it.location) && (
            <p class="meta muted">{[it.org, it.location].filter(Boolean).join(' · ')}</p>
          )}
          {it.details && <p class="details">{it.details}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }
  .entry:last-child {
    border-bottom: 1px solid var(--line);
  }
  .period {
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
  }
  h3 {
    margin-bottom: 0.25rem;
  }
  .meta,
  .details {
    margin: 0;
    font-size: 0.97rem;
  }
  .details {
    margin-top: 0.4rem;
  }
  @media (max-width: 640px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
