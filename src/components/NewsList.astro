---
// News list: year, title, body (rendered markdown), optional image.
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'news'>[];
}
const { items } = Astro.props;
const rendered = await Promise.all(items.map(async (n) => ({ n, Content: (await render(n)).Content })));
---

<ol class="news">
  {
    rendered.map(({ n, Content }, i) => (
      <li class="item" data-reveal style={`--reveal-delay:${Math.min(i, 3) * 80}ms`}>
        <div class="year">{n.data.year}</div>
        <div class="body">
          <h3>{n.data.title}</h3>
          <div class="muted">
            <Content />
          </div>
        </div>
        {n.data.image && (
          <div class="thumb">
            <Image src={n.data.image} alt={n.data.imageAlt ?? ''} widths={[320, 640]} sizes="(max-width: 640px) 100vw, 240px" />
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .news {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }
  .item {
    display: grid;
    grid-template-columns: 90px 1fr 240px;
    gap: 1.5rem;
    align-items: start;
    padding: 1.75rem 0;
    border-top: 1px solid var(--line);
  }
  .item:last-child {
    border-bottom: 1px solid var(--line);
  }
  .item:not(:has(.thumb)) {
    grid-template-columns: 90px 1fr;
  }
  .year {
    font-weight: 650;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    margin-bottom: 0.4rem;
  }
  .body :global(p) {
    margin: 0;
  }
  .thumb {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 3 / 2;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .item:hover .thumb :global(img) {
    transform: scale(1.04);
  }
  @media (max-width: 760px) {
    .item,
    .item:not(:has(.thumb)) {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
