---
// Decorative background animation for the Contact page (pure SVG, no video, no libraries).
// A central "inbox" hub exchanges envelopes with logo nodes (Email, LinkedIn, ...);
// arrivals trigger a ripple and a notification badge. The node ring sways slowly.
// Paused for prefers-reduced-motion.
import { getContactIcon } from '../lib/icons';

interface Props {
  labels: string[]; // one logo node per label, e.g. ['Email', 'GitHub', 'Google Scholar', 'LinkedIn']
}
const { labels } = Astro.props;

const hub = { x: 250, y: 250 };
const PERIOD = 6; // seconds per message cycle (per channel)
const TRAVEL = 0.4; // fraction of the cycle spent travelling
const R = 172; // distance of logo nodes from the hub
const NODE = 24; // logo node radius
const SWAY = 9; // degrees the node ring sways back and forth

const nodes = labels.map((label, i) => {
  const angle = -125 + (i * 360) / labels.length;
  const rad = (angle * Math.PI) / 180;
  const x = hub.x + R * Math.cos(rad);
  const y = hub.y + R * Math.sin(rad);
  // Curve the link a little: control point offset perpendicular to the hub-node line.
  const mx = (hub.x + x) / 2 - 0.25 * (y - hub.y);
  const my = (hub.y + y) / 2 + 0.25 * (x - hub.x);
  return {
    label,
    icon: getContactIcon(label),
    x: +x.toFixed(1),
    y: +y.toFixed(1),
    id: `ca-path-${i}`,
    d: `M${hub.x} ${hub.y} Q${mx.toFixed(1)} ${my.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`,
    dir: i % 2 === 0 ? 'out' : 'in', // out = hub sends to node, in = node sends to hub
    begin: `${(i * PERIOD) / labels.length}s`,
  };
});

const kt = `0;${TRAVEL};1`;
const swayDur = '26s';
---

<div class="contact-anim" aria-hidden="true">
  <svg viewBox="0 0 500 500" class="ca-svg" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="ca-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" class="ca-glow-stop-in"></stop>
        <stop offset="100%" class="ca-glow-stop-out"></stop>
      </radialGradient>
      <pattern id="ca-dots" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1.1" class="ca-dot"></circle>
      </pattern>
      <radialGradient id="ca-fade" cx="50%" cy="50%" r="50%">
        <stop offset="55%" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <mask id="ca-mask"><rect width="500" height="500" fill="url(#ca-fade)"></rect></mask>
      {nodes.map((n) => <path id={n.id} d={n.d} />)}
    </defs>

    <!-- faint dot grid, faded at the edges -->
    <rect width="500" height="500" fill="url(#ca-dots)" mask="url(#ca-mask)"></rect>

    <!-- soft glow behind the hub -->
    <circle cx={hub.x} cy={hub.y} r="170" fill="url(#ca-glow)"></circle>

    <!-- slowly rotating orbit rings -->
    <g>
      <circle cx={hub.x} cy={hub.y} r="72" class="ca-orbit" stroke-dasharray="2 8"></circle>
      <circle cx={hub.x + 72} cy={hub.y} r="3" class="ca-sat"></circle>
      <animateTransform attributeName="transform" type="rotate" from={`0 ${hub.x} ${hub.y}`} to={`360 ${hub.x} ${hub.y}`} dur="70s" repeatCount="indefinite"></animateTransform>
    </g>
    <g>
      <circle cx={hub.x} cy={hub.y} r="118" class="ca-orbit faint" stroke-dasharray="14 10"></circle>
      <circle cx={hub.x} cy={hub.y - 118} r="2.5" class="ca-sat"></circle>
      <animateTransform attributeName="transform" type="rotate" from={`360 ${hub.x} ${hub.y}`} to={`0 ${hub.x} ${hub.y}`} dur="110s" repeatCount="indefinite"></animateTransform>
    </g>
    <circle cx={hub.x} cy={hub.y} r={R} class="ca-orbit fainter"></circle>

    <!-- node ring: links, envelopes and logo nodes sway slowly together around the hub -->
    <g>
      <animateTransform
        attributeName="transform"
        type="rotate"
        values={`${-SWAY} ${hub.x} ${hub.y};${SWAY} ${hub.x} ${hub.y};${-SWAY} ${hub.x} ${hub.y}`}
        dur={swayDur}
        calcMode="spline"
        keySplines="0.45 0 0.55 1;0.45 0 0.55 1"
        repeatCount="indefinite"
      ></animateTransform>

      <!-- connection lines with flowing dashes -->
      {
        nodes.map((n) => (
          <use href={`#${n.id}`} class="ca-link">
            <animate attributeName="stroke-dashoffset" from={n.dir === 'out' ? '40' : '0'} to={n.dir === 'out' ? '0' : '40'} dur="2.4s" repeatCount="indefinite" />
          </use>
        ))
      }

      <!-- travelling envelopes -->
      {
        nodes.map((n) => (
          <g class="ca-packet" opacity="0">
            <rect x="-8" y="-5.5" width="16" height="11" rx="2" />
            <path d="M-8 -4.5 L0 1.5 L8 -4.5" />
            <animateMotion
              dur={`${PERIOD}s`}
              begin={n.begin}
              repeatCount="indefinite"
              calcMode="linear"
              keyPoints={n.dir === 'out' ? '0;1;1' : '1;0;0'}
              keyTimes={kt}
            >
              <mpath href={`#${n.id}`} />
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0;0" keyTimes={`0;0.04;${TRAVEL - 0.03};${TRAVEL};1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
          </g>
        ))
      }

      <!-- logo nodes (kept upright while the ring sways) with ripple + notification badge -->
      {
        nodes.map((n) => (
          <g transform={`translate(${n.x} ${n.y})`}>
            <g>
              <animateTransform
                attributeName="transform"
                type="rotate"
                values={`${SWAY};${-SWAY};${SWAY}`}
                dur={swayDur}
                calcMode="spline"
                keySplines="0.45 0 0.55 1;0.45 0 0.55 1"
                repeatCount="indefinite"
              />
              <circle r={NODE} class="ca-ripple" opacity="0">
                {n.dir === 'out' ? (
                  <>
                    <animate attributeName="r" values={`${NODE};${NODE};${NODE + 24};${NODE + 24}`} keyTimes={`0;${TRAVEL};${TRAVEL + 0.25};1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
                    <animate attributeName="opacity" values="0;0.7;0;0" keyTimes={`0;${TRAVEL};${TRAVEL + 0.25};1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
                  </>
                ) : (
                  <>
                    <animate attributeName="r" values={`${NODE};${NODE + 24};${NODE + 24}`} keyTimes="0;0.25;1" dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
                    <animate attributeName="opacity" values="0.7;0;0" keyTimes="0;0.25;1" dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
                  </>
                )}
              </circle>
              <circle r={NODE} class="ca-node" />
              <g transform="translate(-12 -12)" style={`color:${n.icon.color}`}>
                {n.icon.stroke ? (
                  <path d={n.icon.path} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                ) : (
                  <path d={n.icon.path} fill="currentColor" />
                )}
              </g>
              {n.dir === 'out' && (
                <circle cx={NODE * 0.72} cy={-NODE * 0.72} r="0" class="ca-badge">
                  <animate attributeName="r" values="0;0;7;6;6;0;0" keyTimes={`0;${TRAVEL};${TRAVEL + 0.05};${TRAVEL + 0.08};0.88;0.93;1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
                </circle>
              )}
            </g>
          </g>
        ))
      }
    </g>

    <!-- hub: pulse rings + envelope -->
    <circle cx={hub.x} cy={hub.y} r="40" class="ca-pulse">
      <animate attributeName="r" values="40;92" dur="3s" repeatCount="indefinite"></animate>
      <animate attributeName="opacity" values="0.55;0" dur="3s" repeatCount="indefinite"></animate>
    </circle>
    <circle cx={hub.x} cy={hub.y} r="40" class="ca-pulse">
      <animate attributeName="r" values="40;92" dur="3s" begin="1.5s" repeatCount="indefinite"></animate>
      <animate attributeName="opacity" values="0.55;0" dur="3s" begin="1.5s" repeatCount="indefinite"></animate>
    </circle>
    <circle cx={hub.x} cy={hub.y} r="40" class="ca-hub"></circle>
    <g class="ca-hub-icon" transform={`translate(${hub.x} ${hub.y})`}>
      <rect x="-16" y="-11" width="32" height="22" rx="3"></rect>
      <path d="M-16 -9 L0 3 L16 -9"></path>
    </g>

    <!-- floating chat bubble with typing dots -->
    <g class="ca-bubble" transform="translate(400 250)">
      <rect x="-26" y="-13" width="52" height="26" rx="13"></rect>
      {[-10, 0, 10].map((dx, i) => (
        <circle cx={dx} cy="0" r="2.6" class="ca-typing">
          <animate attributeName="opacity" values="0.25;1;0.25" dur="1.2s" begin={`${i * 0.2}s`} repeatCount="indefinite" />
        </circle>
      ))}
      <animateTransform attributeName="transform" type="translate" values="400 250;400 240;400 250" dur="5s" repeatCount="indefinite"></animateTransform>
    </g>
  </svg>
</div>

<script>
  // Respect reduced motion: freeze the SVG on a nice frame.
  function initContactAnim() {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<SVGSVGElement>('.ca-svg').forEach((svg) => {
      if (reduce) {
        svg.setCurrentTime(2.2);
        svg.pauseAnimations();
      }
    });
  }
  document.addEventListener('astro:page-load', initContactAnim);
</script>

<style>
  .contact-anim {
    position: absolute;
    top: 56px;
    right: calc(var(--gutter) - 30px);
    width: min(33vw, 420px);
    aspect-ratio: 1;
    pointer-events: none;
    z-index: 0;
    opacity: 0.92;
  }
  .ca-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ca-glow-stop-in {
    stop-color: var(--accent);
    stop-opacity: 0.16;
  }
  .ca-glow-stop-out {
    stop-color: var(--accent);
    stop-opacity: 0;
  }
  .ca-dot {
    fill: var(--accent);
    opacity: 0.18;
  }
  .ca-orbit {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.45;
  }
  .ca-orbit.faint {
    opacity: 0.25;
  }
  .ca-orbit.fainter {
    opacity: 0.12;
  }
  .ca-sat {
    fill: var(--accent);
    opacity: 0.8;
  }
  .ca-link {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 3 7;
    opacity: 0.35;
  }
  .ca-pulse {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .ca-hub {
    fill: var(--bg-elev);
    stroke: var(--accent);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--accent) 45%, transparent));
  }
  .ca-hub-icon rect,
  .ca-hub-icon path,
  .ca-packet rect,
  .ca-packet path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .ca-packet rect {
    fill: var(--bg-elev);
  }
  .ca-packet {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 60%, transparent));
  }
  .ca-node {
    fill: var(--bg-elev);
    stroke: var(--accent);
    stroke-width: 1.2;
    filter: drop-shadow(0 2px 8px color-mix(in srgb, var(--accent) 25%, transparent));
  }
  .ca-ripple {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .ca-badge {
    fill: #ff4d6d;
    filter: drop-shadow(0 0 4px rgba(255, 77, 109, 0.6));
  }
  .ca-bubble > rect {
    fill: var(--bg-elev);
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.85;
  }
  .ca-typing {
    fill: var(--accent);
  }

  /* Smaller screens: sit faintly behind the content. */
  @media (max-width: 960px) {
    .contact-anim {
      top: 40px;
      right: -20%;
      width: 80vw;
      opacity: 0.22;
    }
  }
</style>
