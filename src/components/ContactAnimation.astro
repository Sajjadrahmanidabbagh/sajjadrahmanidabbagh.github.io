---
// Decorative background animation for the Contact page (pure SVG, no video, no libraries).
// A central "inbox" hub sends envelopes to surrounding nodes and receives some back;
// arrivals trigger a ripple and a notification badge. Paused for prefers-reduced-motion.

const hub = { x: 250, y: 250 };
const PERIOD = 6; // seconds per message cycle (per channel)
const TRAVEL = 0.4; // fraction of the cycle spent travelling

// Peripheral nodes; "out" = hub sends to node, "in" = node sends to hub.
const nodes = [
  { x: 92, y: 118, cx: 120, cy: 230, dir: 'out' },
  { x: 410, y: 92, cx: 360, cy: 150, dir: 'in' },
  { x: 448, y: 318, cx: 330, cy: 330, dir: 'out' },
  { x: 302, y: 446, cx: 320, cy: 340, dir: 'in' },
  { x: 66, y: 372, cx: 150, cy: 300, dir: 'out' },
].map((n, i) => ({
  ...n,
  id: `ca-path-${i}`,
  d: `M${hub.x} ${hub.y} Q${n.cx} ${n.cy} ${n.x} ${n.y}`,
  begin: `${(i * PERIOD) / 5}s`,
}));

const kt = `0;${TRAVEL};1`;
---

<div class="contact-anim" aria-hidden="true">
  <svg viewBox="0 0 500 500" class="ca-svg" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="ca-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" class="ca-glow-stop-in"></stop>
        <stop offset="100%" class="ca-glow-stop-out"></stop>
      </radialGradient>
      <pattern id="ca-dots" width="20" height="20" patternUnits="userSpaceOnUse">
        <circle cx="1.5" cy="1.5" r="1.1" class="ca-dot"></circle>
      </pattern>
      <radialGradient id="ca-fade" cx="50%" cy="50%" r="50%">
        <stop offset="55%" stop-color="#fff" stop-opacity="1"></stop>
        <stop offset="100%" stop-color="#fff" stop-opacity="0"></stop>
      </radialGradient>
      <mask id="ca-mask"><rect width="500" height="500" fill="url(#ca-fade)"></rect></mask>
      {nodes.map((n) => <path id={n.id} d={n.d} />)}
    </defs>

    <!-- faint dot grid, faded at the edges -->
    <rect width="500" height="500" fill="url(#ca-dots)" mask="url(#ca-mask)"></rect>

    <!-- soft glow behind the hub -->
    <circle cx={hub.x} cy={hub.y} r="170" fill="url(#ca-glow)"></circle>

    <!-- rotating orbit rings -->
    <g class="ca-ring">
      <circle cx={hub.x} cy={hub.y} r="72" class="ca-orbit" stroke-dasharray="2 8"></circle>
      <circle cx={hub.x + 72} cy={hub.y} r="3" class="ca-sat"></circle>
      <animateTransform attributeName="transform" type="rotate" from={`0 ${hub.x} ${hub.y}`} to={`360 ${hub.x} ${hub.y}`} dur="28s" repeatCount="indefinite"></animateTransform>
    </g>
    <g class="ca-ring">
      <circle cx={hub.x} cy={hub.y} r="118" class="ca-orbit faint" stroke-dasharray="14 10"></circle>
      <circle cx={hub.x} cy={hub.y - 118} r="2.5" class="ca-sat"></circle>
      <animateTransform attributeName="transform" type="rotate" from={`360 ${hub.x} ${hub.y}`} to={`0 ${hub.x} ${hub.y}`} dur="46s" repeatCount="indefinite"></animateTransform>
    </g>
    <circle cx={hub.x} cy={hub.y} r="190" class="ca-orbit fainter"></circle>

    <!-- connection lines with flowing dashes -->
    {
      nodes.map((n) => (
        <use href={`#${n.id}`} class="ca-link">
          <animate attributeName="stroke-dashoffset" from={n.dir === 'out' ? '40' : '0'} to={n.dir === 'out' ? '0' : '40'} dur="2.4s" repeatCount="indefinite" />
        </use>
      ))
    }

    <!-- hub: pulse rings + envelope -->
    <circle cx={hub.x} cy={hub.y} r="40" class="ca-pulse">
      <animate attributeName="r" values="40;92" dur="3s" repeatCount="indefinite"></animate>
      <animate attributeName="opacity" values="0.55;0" dur="3s" repeatCount="indefinite"></animate>
    </circle>
    <circle cx={hub.x} cy={hub.y} r="40" class="ca-pulse">
      <animate attributeName="r" values="40;92" dur="3s" begin="1.5s" repeatCount="indefinite"></animate>
      <animate attributeName="opacity" values="0.55;0" dur="3s" begin="1.5s" repeatCount="indefinite"></animate>
    </circle>
    <circle cx={hub.x} cy={hub.y} r="40" class="ca-hub"></circle>
    <g class="ca-hub-icon" transform={`translate(${hub.x} ${hub.y})`}>
      <rect x="-16" y="-11" width="32" height="22" rx="3"></rect>
      <path d="M-16 -9 L0 3 L16 -9"></path>
    </g>

    <!-- peripheral nodes with ripple + notification badge -->
    {
      nodes.map((n) => (
        <g transform={`translate(${n.x} ${n.y})`}>
          <circle r="15" class="ca-ripple" opacity="0">
            {n.dir === 'out' ? (
              <>
                <animate attributeName="r" values="15;15;40;40" keyTimes={`0;${TRAVEL};${TRAVEL + 0.25};1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
                <animate attributeName="opacity" values="0;0.7;0;0" keyTimes={`0;${TRAVEL};${TRAVEL + 0.25};1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
              </>
            ) : (
              <>
                <animate attributeName="r" values="15;40;40" keyTimes="0;0.25;1" dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
                <animate attributeName="opacity" values="0.7;0;0" keyTimes="0;0.25;1" dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
              </>
            )}
          </circle>
          <circle r="15" class="ca-node" />
          <circle r="5" class="ca-node-core" />
          {n.dir === 'out' && (
            <circle cx="12" cy="-12" r="0" class="ca-badge">
              <animate attributeName="r" values="0;0;7;6;6;0;0" keyTimes={`0;${TRAVEL};${TRAVEL + 0.05};${TRAVEL + 0.08};0.88;0.93;1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
            </circle>
          )}
        </g>
      ))
    }

    <!-- travelling envelopes -->
    {
      nodes.map((n) => (
        <g class="ca-packet" opacity="0">
          <rect x="-8" y="-5.5" width="16" height="11" rx="2" />
          <path d="M-8 -4.5 L0 1.5 L8 -4.5" />
          <animateMotion
            dur={`${PERIOD}s`}
            begin={n.begin}
            repeatCount="indefinite"
            calcMode="linear"
            keyPoints={n.dir === 'out' ? '0;1;1' : '1;0;0'}
            keyTimes={kt}
          >
            <mpath href={`#${n.id}`} />
          </animateMotion>
          <animate attributeName="opacity" values="0;1;1;0;0" keyTimes={`0;0.04;${TRAVEL - 0.03};${TRAVEL};1`} dur={`${PERIOD}s`} begin={n.begin} repeatCount="indefinite" />
        </g>
      ))
    }

    <!-- floating chat bubbles with typing dots -->
    <g class="ca-bubble" transform="translate(372 196)">
      <rect x="-30" y="-15" width="60" height="30" rx="15"></rect>
      {[-12, 0, 12].map((dx, i) => (
        <circle cx={dx} cy="0" r="3" class="ca-typing">
          <animate attributeName="opacity" values="0.25;1;0.25" dur="1.2s" begin={`${i * 0.2}s`} repeatCount="indefinite" />
        </circle>
      ))}
      <animateTransform attributeName="transform" type="translate" values="372 196;372 186;372 196" dur="5s" repeatCount="indefinite"></animateTransform>
    </g>
    <g class="ca-bubble" transform="translate(140 438)">
      <rect x="-38" y="-13" width="76" height="26" rx="13"></rect>
      <rect x="-26" y="-4" width="40" height="3" rx="1.5" class="ca-line"></rect>
      <rect x="-26" y="3" width="26" height="3" rx="1.5" class="ca-line"></rect>
      <animateTransform attributeName="transform" type="translate" values="140 438;140 446;140 438" dur="6.5s" repeatCount="indefinite"></animateTransform>
    </g>
  </svg>
</div>

<script>
  // Respect reduced motion: freeze the SVG on a nice frame.
  function initContactAnim() {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<SVGSVGElement>('.ca-svg').forEach((svg) => {
      if (reduce) {
        svg.setCurrentTime(2.2);
        svg.pauseAnimations();
      }
    });
  }
  document.addEventListener('astro:page-load', initContactAnim);
</script>

<style>
  .contact-anim {
    position: absolute;
    top: 24px;
    right: calc(var(--gutter) - 60px);
    width: min(44vw, 560px);
    aspect-ratio: 1;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;
  }
  .ca-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ca-glow-stop-in {
    stop-color: var(--accent);
    stop-opacity: 0.16;
  }
  .ca-glow-stop-out {
    stop-color: var(--accent);
    stop-opacity: 0;
  }
  .ca-dot {
    fill: var(--accent);
    opacity: 0.18;
  }
  .ca-orbit {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.45;
  }
  .ca-orbit.faint {
    opacity: 0.25;
  }
  .ca-orbit.fainter {
    opacity: 0.12;
  }
  .ca-sat {
    fill: var(--accent);
    opacity: 0.8;
  }
  .ca-link {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 3 7;
    opacity: 0.35;
  }
  .ca-pulse {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .ca-hub {
    fill: var(--bg-elev);
    stroke: var(--accent);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--accent) 45%, transparent));
  }
  .ca-hub-icon rect,
  .ca-hub-icon path,
  .ca-packet rect,
  .ca-packet path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .ca-packet rect {
    fill: var(--bg-elev);
  }
  .ca-packet {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 60%, transparent));
  }
  .ca-node {
    fill: var(--bg-elev);
    stroke: var(--accent);
    stroke-width: 1.2;
    opacity: 0.9;
  }
  .ca-node-core {
    fill: var(--accent);
    opacity: 0.55;
  }
  .ca-ripple {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .ca-badge {
    fill: #ff4d6d;
    filter: drop-shadow(0 0 4px rgba(255, 77, 109, 0.6));
  }
  .ca-bubble > rect:first-child {
    fill: var(--bg-elev);
    stroke: var(--accent);
    stroke-width: 1;
    opacity: 0.85;
  }
  .ca-typing,
  .ca-line {
    fill: var(--accent);
  }
  .ca-line {
    opacity: 0.5;
  }

  /* Smaller screens: sit faintly behind the content. */
  @media (max-width: 960px) {
    .contact-anim {
      top: 40px;
      right: -25%;
      width: 90vw;
      opacity: 0.22;
    }
  }
</style>
