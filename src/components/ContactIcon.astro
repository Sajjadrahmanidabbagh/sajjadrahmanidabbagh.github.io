---
// Logo for a contact box, chosen by the link label (Email, GitHub, Google Scholar, LinkedIn).
// Unknown labels get a generic link icon. Icon shapes live in src/lib/icons.ts.
import { getContactIcon } from '../lib/icons';
interface Props {
  label: string;
}

const icon = getContactIcon(Astro.props.label);
---

<span class="contact-icon" style={`color:${icon.color}`} aria-hidden="true">
  {
    icon.stroke ? (
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d={icon.path} />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
        <path d={icon.path} />
      </svg>
    )
  }
</span>

<style>
  .contact-icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    border-radius: 14px;
    background: var(--accent-soft);
    transition: transform 0.35s var(--ease);
  }
</style>
